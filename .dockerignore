# Installed and built inside the image.
node_modules
.next
out
build
coverage

# Secrets and local overrides. Next loads .env* during `next build`, and
# standalone output copies those files into the image. Keep them out.
.env
.env.*

# Not needed to run the server. Blog posts are the exception: the image
# build reads content/blog while prerendering /blog.
.git
.github
.vercel
.cursor
*.md
!content/blog/*.md
Dockerfile
npm-debug.log*
*.tsbuildinfo
.DS_Store
