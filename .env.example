# Copy to .env.local for local development. Never commit real keys.

# Server-only Stripe secret. Checkout stays disabled when this is empty.
STRIPE_SECRET_KEY=

# Publishable key, safe to expose in the browser. Checkout stays disabled when this is empty.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Absolute site origin used for Stripe return URLs, the sitemap, and Open Graph.
# Local example: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
